# Copiar este archivo como ".env" y completar con valores propios.
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-propia
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Producción: dejar vacío usa SQLite (solo development/demo).
# Para PostgreSQL: postgres://usuario:clave@host:5432/nombre_db
DATABASE_URL=

# Media (pictogramas, portadas, etc.) en la nube: necesario en cuanto se
# despliegue a un hosting con filesystem efímero (Heroku, Render, Railway),
# porque ahí lo guardado localmente se pierde en cada redeploy.
# Dejar USE_S3 en False usa el filesystem local (solo development/demo).
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# E-mail (necesario para "olvidé mi contraseña" en producción). En desarrollo,
# dejar todo vacío: los correos se imprimen en la consola del servidor.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tuservicio.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@tudominio.com
