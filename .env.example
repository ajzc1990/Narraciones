# Copiar este archivo como ".env" y completar con valores propios.
# Generar una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-propia
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Producción: dejar vacío usa SQLite (solo development/demo).
# Para PostgreSQL: postgres://usuario:clave@host:5432/nombre_db
DATABASE_URL=

# E-mail (necesario para "olvidé mi contraseña" en producción). En desarrollo,
# dejar todo vacío: los correos se imprimen en la consola del servidor.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tuservicio.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@tudominio.com
